---
// Component to display external blog posts/articles
// Combines: blog posts, systems writing, and technical blogs
import contentData from '../data/content.json';

interface BlogPost {
  title: string;
  platform: string;
  url: string;
  date?: string;
  description?: string;
  tags?: string[];
  category?: string;
  type?: string;
  featured?: boolean;
}

// Combine all writing content
let allPosts: BlogPost[] = [];

// Add systems writing (add date for sorting)
if (contentData.systems_writing) {
  allPosts = [...allPosts, ...contentData.systems_writing.map(p => ({ ...p, date: '2025-01-01' }))];
}

// Add technical blogs (add date for sorting)
if (contentData.technical_blogs) {
  allPosts = [...allPosts, ...contentData.technical_blogs.map(p => ({ ...p, date: '2025-01-01' }))];
}

// Filter to only featured posts
const featuredPosts = allPosts.filter(p => p.featured !== false);

// Sort by date (newest first)
const sortedPosts = featuredPosts.sort((a, b) => {
  const dateA = a.date ? new Date(a.date).getTime() : 0;
  const dateB = b.date ? new Date(b.date).getTime() : 0;
  return dateB - dateA;
}).slice(0, 6); // Limit to 6 featured posts
---

<section class="blog-section">
  <div class="section-header-inline">
    <div>
      <h3 class="text-2xl font-bold mb-2">
        <span class="text-error-red">[</span>
        Writing & Insights
        <span class="text-error-red">]</span>
      </h3>
      <p class="font-mono text-sm text-off-white/60">
        Articles, strategy, and technical deep-dives
      </p>
    </div>
  </div>

  <div class="posts-grid">
    {sortedPosts.map((post) => (
      <a 
        href={post.url}
        target="_blank"
        rel="noopener"
        class="post-card group"
      >
        <!-- Category/Type badge -->
        <div class="badge-container">
          <span class="platform-badge">
            {post.category || post.type || post.platform}
          </span>
          <span class="platform-name font-mono text-xs text-off-white/60">
            {post.platform}
          </span>
        </div>

        <!-- Post content -->
        <div class="post-content">
          {post.date && (
            <time class="post-date font-mono text-xs text-off-white/50">
              {new Date(post.date).toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric' 
              })}
            </time>
          )}

          <h4 class="post-title text-lg font-bold mt-2 mb-3 group-hover:text-cyber-cyan transition-colors">
            {post.title}
          </h4>

          {post.description && (
            <p class="post-description font-mono text-sm text-off-white/70 mb-4">
              {post.description}
            </p>
          )}

          <!-- Tags -->
          {post.tags && post.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {post.tags.slice(0, 3).map(tag => (
                <span class="tag">
                  {tag}
                </span>
              ))}
            </div>
          )}

          <!-- Read more link -->
          <div class="read-more">
            <span class="font-mono text-sm font-semibold">
              Read →
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .blog-section {
    @apply mb-12;
  }

  .section-header-inline {
    @apply mb-8;
  }

  .posts-grid {
    @apply grid gap-4;
    @apply grid-cols-1 md:grid-cols-2 lg:grid-cols-3;
  }

  .post-card {
    @apply relative border-brutal border-black bg-dark-grey;
    @apply shadow-hard hover:shadow-hard-red;
    @apply transition-all duration-200;
    @apply p-6;
    @apply cursor-pointer;
  }

  .post-card:hover {
    @apply -translate-y-1;
  }

  .post-card:active {
    @apply shadow-hard-collapsed translate-x-1 translate-y-1;
  }

  .badge-container {
    @apply flex items-center gap-2 mb-4;
  }

  .platform-badge {
    @apply inline-block px-2 py-1;
    @apply border border-off-white/30 bg-error-red text-black;
    @apply text-xs font-mono font-bold uppercase tracking-wide;
  }

  .platform-name {
    @apply text-off-white/60;
  }

  .post-date {
    @apply block;
  }

  .post-title {
    @apply text-off-white;
  }

  .post-description {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag {
    @apply px-2 py-1 border border-off-white/20;
    @apply text-xs font-mono uppercase tracking-wide;
    @apply bg-graphite text-off-white/80;
  }

  .read-more {
    @apply mt-4 pt-4 border-t border-off-white/10;
    @apply text-off-white group-hover:text-cyber-cyan;
    @apply transition-colors;
  }
</style>
