---
// GitHub contribution graph component
// Uses the GitHub GraphQL API to fetch contribution data

interface ContributionDay {
  contributionCount: number;
  date: string;
  color: string;
}

interface GitHubStats {
  totalContributions: number;
  weeks: ContributionDay[][];
}

const GITHUB_USERNAME = 'aryankargwal'; // Your GitHub username
const GITHUB_GRAPHQL_API = 'https://api.github.com/graphql';

// You'll need a GitHub Personal Access Token for this
// Get one at: https://github.com/settings/tokens
// Only needs 'read:user' scope
const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN || '';

let stats: GitHubStats = {
  totalContributions: 0,
  weeks: []
};

if (GITHUB_TOKEN) {
  try {
    const query = `
      query($userName:String!) {
        user(login: $userName) {
          contributionsCollection {
            contributionCalendar {
              totalContributions
              weeks {
                contributionDays {
                  contributionCount
                  date
                }
              }
            }
          }
        }
      }
    `;

    const response = await fetch(GITHUB_GRAPHQL_API, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${GITHUB_TOKEN}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        query,
        variables: { userName: GITHUB_USERNAME }
      })
    });

    const data = await response.json();
    
    if (data.data?.user?.contributionsCollection) {
      const calendar = data.data.user.contributionsCollection.contributionCalendar;
      stats.totalContributions = calendar.totalContributions;
      
      // Map contribution counts to colors (neo-brutalist style)
      stats.weeks = calendar.weeks.map((week: any) => {
        return week.contributionDays.map((day: any) => {
          let color = '#1a1a1a'; // No contributions
          
          if (day.contributionCount > 0) color = '#00f3ff33'; // 1-3 contributions (cyber cyan, low opacity)
          if (day.contributionCount > 3) color = '#00f3ff66'; // 4-6 contributions
          if (day.contributionCount > 6) color = '#00f3ff99'; // 7-9 contributions
          if (day.contributionCount > 9) color = '#00f3ff'; // 10+ contributions (full cyber cyan)
          
          return {
            contributionCount: day.contributionCount,
            date: day.date,
            color
          };
        });
      });
    }
  } catch (error) {
    console.error('Failed to fetch GitHub stats:', error);
  }
}

// Get last 52 weeks only
const recentWeeks = stats.weeks.slice(-52);
---

<section class="github-section">
  <div class="section-header-inline">
    <div>
      <h3 class="text-3xl font-black mb-2 text-off-white">
        <span style="color: #ff9500">[</span>
        GitHub Activity
        <span style="color: #ff9500">]</span>
      </h3>
      {stats.totalContributions > 0 && (
        <p class="font-mono text-sm text-off-white/60">
          {stats.totalContributions} contributions in the last year
        </p>
      )}
    </div>
    <a 
      href={`https://github.com/${GITHUB_USERNAME}`}
      target="_blank"
      rel="noopener"
      class="text-sm font-mono hover:text-cyber-cyan"
    >
      @{GITHUB_USERNAME} →
    </a>
  </div>

  {recentWeeks.length > 0 ? (
    <div class="contribution-graph">
      <div class="graph-container">
        {recentWeeks.map((week) => (
          <div class="week-column">
            {week.map((day) => (
              <div
                class="contribution-day"
                style={`background-color: ${day.color};`}
                title={`${day.date}: ${day.contributionCount} contributions`}
                data-count={day.contributionCount}
              />
            ))}
          </div>
        ))}
      </div>
      
      <!-- Legend -->
      <div class="graph-legend">
        <span class="font-mono text-xs text-off-white/60">Less</span>
        <div class="legend-day" style="background-color: #1a1a1a;"></div>
        <div class="legend-day" style="background-color: #00f3ff33;"></div>
        <div class="legend-day" style="background-color: #00f3ff66;"></div>
        <div class="legend-day" style="background-color: #00f3ff99;"></div>
        <div class="legend-day" style="background-color: #00f3ff;"></div>
        <span class="font-mono text-xs text-off-white/60">More</span>
      </div>
    </div>
  ) : (
    <div class="no-data-box">
      <p class="font-mono text-sm text-off-white/60 mb-3">
        GitHub contribution graph unavailable.
      </p>
      <p class="font-mono text-xs text-off-white/40">
        Add a GITHUB_TOKEN environment variable to display your contribution graph.
      </p>
      <a 
        href="https://github.com/settings/tokens"
        target="_blank"
        rel="noopener"
        class="text-xs font-mono text-cyber-cyan hover:text-acid-lime mt-2 inline-block"
      >
        Generate token →
      </a>
    </div>
  )}
</section>

<style>
  .github-section {
    @apply border-brutal border-black bg-dark-grey;
    @apply p-6 md:p-8 shadow-hard;
  }

  .section-header-inline {
    @apply flex justify-between items-start mb-6;
  }

  .contribution-graph {
    @apply overflow-x-auto;
  }

  .graph-container {
    @apply flex gap-1;
    min-width: fit-content;
  }

  .week-column {
    @apply flex flex-col gap-1;
  }

  .contribution-day {
    @apply w-3 h-3 border border-black/20;
    @apply transition-all duration-150;
    @apply cursor-pointer;
  }

  .contribution-day:hover {
    @apply border-cyber-cyan border-brutal;
    @apply shadow-hard-sm;
    transform: scale(1.2);
  }

  .graph-legend {
    @apply flex items-center gap-2 mt-4 justify-end;
  }

  .legend-day {
    @apply w-3 h-3 border border-black/20;
  }

  .no-data-box {
    @apply border-brutal border-error-red/30 bg-graphite;
    @apply p-6 text-center;
  }

  /* Responsive scrolling hint */
  @media (max-width: 768px) {
    .graph-container {
      @apply pb-2;
    }
    
    .contribution-graph::after {
      content: '→ Scroll';
      @apply absolute right-0 top-1/2 -translate-y-1/2;
      @apply font-mono text-xs text-off-white/40;
      @apply pointer-events-none;
    }
  }
</style>
