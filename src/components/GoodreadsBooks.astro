---
// This component fetches currently reading books from Goodreads RSS feed

interface Book {
  title: string;
  author: string;
  link: string;
  coverUrl: string;
}

interface ReadingStats {
  booksReadThisYear: number;
  currentlyReading: number;
  pagesRead: number;
}

const GOODREADS_USER_ID = import.meta.env.GOODREADS_USER_ID || '185223761';
const CURRENTLY_READING_URL = `https://www.goodreads.com/review/list_rss/${GOODREADS_USER_ID}?shelf=currently-reading`;
const READ_SHELF_URL = `https://www.goodreads.com/review/list_rss/${GOODREADS_USER_ID}?shelf=read`;

let currentlyReadingBooks: Book[] = [];
let booksReadThisYear: Book[] = [];
let stats: ReadingStats = {
  booksReadThisYear: 0,
  currentlyReading: 0,
  pagesRead: 0
};

// Helper function to extract XML text content
function extractXMLContent(xml: string, tag: string): string {
  const pattern = new RegExp(`<${tag}><!\\[CDATA\\[(.*?)\\]\\]></${tag}>|<${tag}>([^<]*)</${tag}>`);
  const match = xml.match(pattern);
  return match ? (match[1] || match[2] || '') : '';
}

// Fetch currently reading books
try {
  const response = await fetch(CURRENTLY_READING_URL, {
    headers: {
      'User-Agent': 'Mozilla/5.0 (compatible; Astro/5.0)'
    }
  });
  
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
  
  const xmlText = await response.text();
  
  // Split by <item> tags
  const itemsRaw = xmlText.split('<item>');
  
  for (let i = 1; i < itemsRaw.length; i++) {
    const itemXml = '<item>' + itemsRaw[i].split('</item>')[0] + '</item>';
    
    // Extract title
    const title = extractXMLContent(itemXml, 'title');
    if (!title) continue;
    
    // Extract author
    const author = extractXMLContent(itemXml, 'author_name');
    
    // Extract link
    const link = extractXMLContent(itemXml, 'link');
    
    // Extract cover (prefer large, then medium, then small)
    let coverUrl = extractXMLContent(itemXml, 'book_large_image_url');
    if (!coverUrl) coverUrl = extractXMLContent(itemXml, 'book_medium_image_url');
    if (!coverUrl) coverUrl = extractXMLContent(itemXml, 'book_image_url');
    
    if (title && coverUrl) {
      currentlyReadingBooks.push({ 
        title, 
        author: author || 'Unknown', 
        link: link || '#', 
        coverUrl 
      });
    }
  }
  
  stats.currentlyReading = currentlyReadingBooks.length;
  console.log(`✓ Fetched ${currentlyReadingBooks.length} currently reading books`);
} catch (error) {
  console.error('✗ Failed to fetch Goodreads books:', error);
  // Fallback
  currentlyReadingBooks = [
    {
      title: "21 Lessons for the 21st Century",
      author: "Yuval Noah Harari",
      link: "https://www.goodreads.com/book/show/38820046",
      coverUrl: "https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/books/1564577305l/38820046._SY475_.jpg"
    }
  ];
  stats.currentlyReading = 1;
}

// Fetch books read this year
try {
  const response = await fetch(READ_SHELF_URL, {
    headers: {
      'User-Agent': 'Mozilla/5.0 (compatible; Astro/5.0)'
    }
  });
  
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
  
  const xmlText = await response.text();
  const currentYear = new Date().getFullYear();
  
  // Split by <item> tags
  const itemsRaw = xmlText.split('<item>');
  
  let booksThisYearCount = 0;
  let totalPages = 0;
  
  for (let i = 1; i < itemsRaw.length; i++) {
    const itemXml = '<item>' + itemsRaw[i].split('</item>')[0] + '</item>';
    
    // Extract read date
    const readAtStr = extractXMLContent(itemXml, 'user_read_at');
    if (!readAtStr) continue;
    
    const readDate = new Date(readAtStr);
    if (readDate.getFullYear() === currentYear) {
      booksThisYearCount++;
      
      // Extract book details for display
      const title = extractXMLContent(itemXml, 'title');
      if (title) {
        const author = extractXMLContent(itemXml, 'author_name');
        const link = extractXMLContent(itemXml, 'link');
        let coverUrl = extractXMLContent(itemXml, 'book_large_image_url');
        if (!coverUrl) coverUrl = extractXMLContent(itemXml, 'book_medium_image_url');
        if (!coverUrl) coverUrl = extractXMLContent(itemXml, 'book_image_url');
        
        if (coverUrl) {
          booksReadThisYear.push({
            title,
            author: author || 'Unknown',
            link: link || '#',
            coverUrl
          });
        }
      }
      
      // Extract page count from <num_pages> inside <book> tag
      const numPagesMatch = itemXml.match(/<num_pages>(\d+)<\/num_pages>/);
      if (numPagesMatch && numPagesMatch[1]) {
        totalPages += parseInt(numPagesMatch[1]);
      }
    }
  }
  
  stats.booksReadThisYear = booksThisYearCount;
  stats.pagesRead = totalPages;
  console.log(`✓ Fetched ${booksThisYearCount} books read this year (${totalPages} pages) with ${booksReadThisYear.length} covers`);
} catch (error) {
  console.error('✗ Failed to fetch reading stats:', error);
  stats.booksReadThisYear = 0;
  stats.pagesRead = 0;
}
---

<section class="currently-reading" data-goodreads-user-id={GOODREADS_USER_ID}>
  <div class="section-header-inline">
    <h3 class="text-3xl font-black mb-6 text-off-white">
      <span class="text-acid-lime">[</span>
      Currently Reading
      <span class="text-acid-lime">]</span>
    </h3>
    <a 
      href={`https://www.goodreads.com/user/show/${GOODREADS_USER_ID}`}
      target="_blank"
      rel="noopener"
      class="text-sm font-mono hover:text-acid-lime"
    >
      View on Goodreads →
    </a>
  </div>

  <div class="reading-layout">
    <!-- Stats Box with Tabs -->
    <div class="stats-box">
      <div class="stat-tabs">
        <button class="stat-tab active" data-stat="reading">
          <div class="stat-number" data-value={stats.currentlyReading} data-stat-value="reading">
            {stats.currentlyReading}
          </div>
          <div class="stat-label">Currently Reading</div>
        </button>
        <button class="stat-tab" data-stat="year">
          <div class="stat-number" data-value={stats.booksReadThisYear} data-stat-value="year">
            {stats.booksReadThisYear}
          </div>
          <div class="stat-label">Read This Year</div>
        </button>
      </div>
    </div>

    <!-- Books Grid - Currently Reading -->
    <div class="books-container" id="readingContainer">
       {currentlyReadingBooks.length > 0 ? (
        <div class="books-grid">
           {currentlyReadingBooks.map((book: Book) => {
             return (
               <a 
                 href={book.link}
                 target="_blank"
                 rel="noopener"
                 class="book-card"
               >
                 {book.coverUrl && (
                   <img 
                     src={book.coverUrl} 
                     alt={book.title}
                     class="book-cover"
                     loading="lazy"
                     style="filter: none; saturate: 100%;"
                   />
                 )}
                 <div class="book-info">
                   <p class="book-title font-mono text-xs font-semibold line-clamp-2 mb-1">
                     {book.title}
                   </p>
                   {book.author && (
                     <p class="book-author font-mono text-xs text-off-white/60">
                       {book.author}
                     </p>
                   )}
                 </div>
               </a>
             );
           })}
        </div>
      ) : (
        <p class="font-mono text-sm text-off-white/60">
          No books currently being read. Check back later!
        </p>
      )}
    </div>

    <!-- Books Grid - Read This Year -->
    <div class="books-container" id="yearContainer" style="display: none;">
       {booksReadThisYear.length > 0 ? (
        <div class="books-grid">
           {booksReadThisYear.map((book: Book) => {
             return (
               <a 
                 href={book.link}
                 target="_blank"
                 rel="noopener"
                 class="book-card"
               >
                 {book.coverUrl && (
                   <img 
                     src={book.coverUrl} 
                     alt={book.title}
                     class="book-cover"
                     loading="lazy"
                   />
                 )}
                 <div class="book-info">
                   <p class="book-title font-mono text-xs font-semibold line-clamp-2 mb-1">
                     {book.title}
                   </p>
                   {book.author && (
                     <p class="book-author font-mono text-xs text-off-white/60">
                       {book.author}
                     </p>
                   )}
                 </div>
               </a>
             );
           })}
        </div>
      ) : (
        <p class="font-mono text-sm text-off-white/60">
          No books read this year yet. Check back later!
        </p>
      )}
    </div>
  </div>

  <script is:inline>
    // Handle stat tab switching and books display
    const tabs = document.querySelectorAll('.stat-tab');
    const readingContainer = document.getElementById('readingContainer');
    const yearContainer = document.getElementById('yearContainer');
    
    tabs.forEach((tab) => {
      tab.addEventListener('click', function() {
        // Remove active from all tabs
        tabs.forEach(t => t.classList.remove('active'));
        // Add active to clicked tab
        this.classList.add('active');
        
        // Switch book display
        const stat = this.getAttribute('data-stat');
        if (stat === 'reading') {
          readingContainer.style.display = 'flex';
          yearContainer.style.display = 'none';
        } else if (stat === 'year') {
          readingContainer.style.display = 'none';
          yearContainer.style.display = 'flex';
        }
      });
    });

    // Refresh Goodreads data on each user page load so updates don't need a site redeploy.
    // Goodreads RSS blocks browser CORS, so we go through a proxy.
    // We use the same regex-based XML parsing as the server-side code because Goodreads
    // uses namespace-prefixed tags (e.g. <gr:author_name>) that DOMParser's querySelector
    // cannot find by simple tag name.

    const section = document.querySelector('.currently-reading[data-goodreads-user-id]');
    const goodreadsUserId = section?.getAttribute('data-goodreads-user-id');
    const readingStat = document.querySelector('[data-stat-value="reading"]');
    const yearStat = document.querySelector('[data-stat-value="year"]');

    // Extract a tag's text content from a raw XML string (handles CDATA and plain text).
    const extractXML = (xml, tag) => {
      const pattern = new RegExp(
        `<${tag}><!\\[CDATA\\[([\\s\\S]*?)\\]\\]><\\/${tag}>|<${tag}>([^<]*)<\\/${tag}>`
      );
      const match = xml.match(pattern);
      return match ? (match[1] || match[2] || '').trim() : '';
    };

    // Try allorigins first, fall back to corsproxy.io.
    const fetchShelfXml = async (url) => {
      const proxies = [
        `https://api.allorigins.win/raw?url=${encodeURIComponent(url)}`,
        `https://corsproxy.io/?${encodeURIComponent(url)}`,
      ];
      for (const proxy of proxies) {
        try {
          const res = await fetch(proxy);
          if (res.ok) return res.text();
        } catch (_) {
          // try next proxy
        }
      }
      throw new Error('All Goodreads proxies failed');
    };

    const parseItems = (xmlText) => {
      const rawItems = xmlText.split('<item>');
      const items = [];
      for (let i = 1; i < rawItems.length; i++) {
        const chunk = '<item>' + rawItems[i].split('</item>')[0] + '</item>';
        const title = extractXML(chunk, 'title');
        if (!title) continue;
        const author = extractXML(chunk, 'author_name');
        const link = extractXML(chunk, 'link');
        let coverUrl = extractXML(chunk, 'book_large_image_url');
        if (!coverUrl) coverUrl = extractXML(chunk, 'book_medium_image_url');
        if (!coverUrl) coverUrl = extractXML(chunk, 'book_image_url');
        const readAt = extractXML(chunk, 'user_read_at');
        const numPagesMatch = chunk.match(/<num_pages>(\d+)<\/num_pages>/);
        items.push({
          title,
          author: author || 'Unknown',
          link: link || '#',
          coverUrl,
          readAt,
          numPages: numPagesMatch ? parseInt(numPagesMatch[1]) : 0,
        });
      }
      return items;
    };

    const createBookCard = (book) => {
      const anchor = document.createElement('a');
      anchor.href = book.link;
      anchor.target = '_blank';
      anchor.rel = 'noopener';
      anchor.className = 'book-card';

      if (book.coverUrl) {
        const img = document.createElement('img');
        img.src = book.coverUrl;
        img.alt = book.title;
        img.className = 'book-cover';
        img.loading = 'lazy';
        anchor.appendChild(img);
      }

      const info = document.createElement('div');
      info.className = 'book-info';

      const titleEl = document.createElement('p');
      titleEl.className = 'book-title font-mono text-xs font-semibold line-clamp-2 mb-1';
      titleEl.textContent = book.title;
      info.appendChild(titleEl);

      if (book.author) {
        const authorEl = document.createElement('p');
        authorEl.className = 'book-author font-mono text-xs text-off-white/60';
        authorEl.textContent = book.author;
        info.appendChild(authorEl);
      }

      anchor.appendChild(info);
      return anchor;
    };

    const renderBooks = (container, books, emptyMessage) => {
      if (!container) return;
      if (!books.length) {
        const p = document.createElement('p');
        p.className = 'font-mono text-sm text-off-white/60';
        p.textContent = emptyMessage;
        container.replaceChildren(p);
        return;
      }
      const grid = document.createElement('div');
      grid.className = 'books-grid';
      books.forEach((book) => grid.appendChild(createBookCard(book)));
      container.replaceChildren(grid);
    };

    const refreshGoodreads = async () => {
      if (!goodreadsUserId) return;

      const currentUrl = `https://www.goodreads.com/review/list_rss/${goodreadsUserId}?shelf=currently-reading`;
      const readUrl   = `https://www.goodreads.com/review/list_rss/${goodreadsUserId}?shelf=read`;

      try {
        const [currentXml, readXml] = await Promise.all([
          fetchShelfXml(currentUrl),
          fetchShelfXml(readUrl),
        ]);

        const currentItems = parseItems(currentXml);
        const readItems    = parseItems(readXml);

        const currentlyReadingBooks = currentItems.filter((b) => b.title && b.coverUrl);

        const currentYear = new Date().getFullYear();
        let booksReadThisYearCount = 0;
        const booksReadThisYear = [];

        for (const book of readItems) {
          if (!book.readAt) continue;
          if (new Date(book.readAt).getFullYear() !== currentYear) continue;
          booksReadThisYearCount++;
          if (book.title && book.coverUrl) booksReadThisYear.push(book);
        }

        if (readingStat) readingStat.textContent = String(currentlyReadingBooks.length);
        if (yearStat)    yearStat.textContent    = String(booksReadThisYearCount);

        renderBooks(readingContainer, currentlyReadingBooks, 'No books currently being read. Check back later!');
        renderBooks(yearContainer, booksReadThisYear, 'No books read this year yet. Check back later!');

        console.log(`✓ Goodreads refreshed: ${currentlyReadingBooks.length} reading, ${booksReadThisYearCount} read this year`);
      } catch (error) {
        console.error('✗ Goodreads client refresh failed (showing build-time data):', error);
      }
    };

    refreshGoodreads();
  </script>
</section>

<style>
  .currently-reading {
    @apply mb-12;
  }

  .section-header-inline {
    @apply flex justify-between items-center mb-6;
  }

  .reading-layout {
    @apply flex flex-col lg:flex-row gap-8;
  }

  /* Stats Box */
  .stats-box {
    @apply border-brutal border-black bg-dark-grey shadow-hard;
    @apply p-0 flex-shrink-0;
    @apply lg:min-w-[180px] lg:max-w-[180px];
  }

  .stat-tabs {
    @apply flex flex-col;
  }

  .stat-tab {
    @apply p-6 text-center border-0 bg-dark-grey cursor-pointer;
    @apply transition-all duration-200;
    @apply hover:bg-graphite;
  }

  .stat-tab:last-child {
    @apply border-b-0;
  }

  .stat-tab.active {
    @apply bg-graphite;
  }

  .stat-tab:active {
    @apply translate-y-1;
  }

  .stat-number {
    @apply text-4xl font-black text-cyber-cyan mb-1 font-mono;
  }

  .stat-label {
    @apply text-xs font-mono text-off-white/60 uppercase tracking-wide;
  }

  .books-container {
    @apply flex-1;
  }

  .books-grid {
    @apply grid gap-4;
    @apply grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5;
  }

  .book-card {
    @apply border-brutal border-black bg-dark-grey;
    @apply shadow-hard hover:shadow-hard-cyan;
    @apply transition-all duration-200;
    @apply cursor-pointer;
    @apply relative;
    filter: none !important;
  }

  .book-card:hover {
    @apply -translate-y-2;
  }

  .book-card:active {
    @apply shadow-hard-collapsed translate-x-1 translate-y-1;
  }

   .book-algo-icon {
     @apply absolute top-2 right-2 text-lg font-bold text-cyber-cyan opacity-70;
     @apply font-mono z-10;
   }

   .book-ascii {
     @apply border-t-brutal border-black p-2 bg-dark-grey;
     @apply text-center;
   }

   .ascii-art {
     @apply font-mono text-xs leading-tight;
     @apply m-0 p-0;
     word-break: break-all;
     white-space: pre-wrap;
     color: #00f3ff;
   }

   .ascii-label {
     @apply text-xs font-mono text-off-white/60 mt-1 mb-0;
     @apply uppercase tracking-wider font-bold;
   }

  .book-cover {
    @apply w-full h-auto;
    @apply border-b-brutal border-black;
    aspect-ratio: 2/3;
    object-fit: cover;
    filter: none;
  }

  .book-info {
    @apply p-3 bg-graphite;
  }

  .book-title {
    @apply text-off-white;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Fallback for no books */
  .currently-reading p {
    @apply text-center py-8;
  }
</style>
