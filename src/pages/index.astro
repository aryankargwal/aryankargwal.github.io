---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GoodreadsBooks from '../components/GoodreadsBooks.astro';
import YouTubeVideos from '../components/YouTubeVideos.astro';
import contentData from '../data/content.json';
import { generateProbabilityGrid } from '../utils/probabilityGrids';
import { getCollection } from 'astro:content';

// Fetch all projects, sorted by date (newest first)
const allProjects = await getCollection('projects');
const projects = allProjects
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Get featured blogs from all sections (ONLY blogs, no videos)
const featuredBlogs = [
  ...contentData.systems_writing
    .filter(blog => blog.featured)
    .map(blog => ({
      title: blog.title,
      platform: blog.platform,
      url: blog.url,
      date: blog.date || '2000-01-01',
      excerpt: blog.excerpt,
      category: blog.category
    })),
  ...contentData.technical_blogs
    .filter(blog => blog.featured)
    .map(blog => ({
      title: blog.title,
      platform: blog.platform,
      url: blog.url,
      date: blog.date || '2000-01-01',
      excerpt: blog.excerpt,
      category: blog.category
    }))
]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 6); // Show only 6 featured blogs

// Generate grids with color rotation
let colorHistory: string[] = [];
const blogsWithGrids = featuredBlogs.map(blog => {
  const grid = generateProbabilityGrid(blog.title, colorHistory);
  colorHistory = grid.usedColors;
  return {
    ...blog,
    grid
  };
});
---

<Layout title="Aryan Kargwal - Research Portfolio">
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container-brutal">
        <div class="hero-content">
           <!-- Left Column: Text -->
           <div class="hero-text-column">
             <!-- Name plate -->
             <div class="name-plate">
               <h1 class="glitch-text" data-text="ARYAN KARGWAL">
                 ARYAN KARGWAL
               </h1>
             </div>
             
             <!-- Tagline -->
             <div class="tagline-box">
               <p class="font-mono text-lg md:text-xl">
                 <span class="text-cyber-cyan">[PhD Researcher]</span>
                 <span class="text-off-white/80"> AI & Robotics</span>
                 <br />
                 <span class="text-acid-lime">@</span>
                 <span class="text-off-white"> Polytechnique Montréal</span>
               </p>
             </div>
             
             <!-- Quick links -->
             <div class="quick-links">
               <a href="#lab-bench" class="btn-brutal">
                 Research
               </a>
               <a href="#input" class="btn-brutal">
                 Reading
               </a>
               <a href="mailto:aryan.kargwal@polymtl.ca" class="btn-brutal">
                 Contact
               </a>
             </div>
           </div>

           <!-- Right Column: Profile Picture -->
           <div class="hero-image-column">
             <div class="profile-picture">
               <img 
                 src="/img/aryan-profile.png" 
                 alt="Aryan Kargwal"
                 class="pfp-img"
               />
             </div>
           </div>
        </div>
      </div>
    </section>

    <!-- Lab Bench: Research Projects (Bento Grid) -->
    <section id="lab-bench" class="section-brutal" style="padding-top: 4rem;">
      <div class="container-brutal">
        <!-- Section header -->
        <div class="section-header">
          <h2 class="section-title">
            <span class="title-bracket">[</span>
            THE LAB BENCH
            <span class="title-bracket">]</span>
          </h2>
          <p class="font-mono text-off-white/60">
            Systems Engineering & Research Prototypes
          </p>
        </div>

        <!-- Bento Grid -->
        <div class="bento-grid">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              status={project.data.status}
              repoUrl={project.data.repoUrl}
              paperUrl={project.data.paperUrl}
              demoUrl={project.data.demoUrl}
              slug={project.slug}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Selected Achievements -->
    <section id="achievements" class="section-brutal achievements-section">
      <div class="container-brutal">
        <div class="section-header achievements-header">
          <h2 class="section-title">
            <span class="title-bracket">[</span>
            SELECTED ACHIEVEMENTS
            <span class="title-bracket">]</span>
          </h2>
          <p class="font-mono text-off-white/60">
            Robotics, AI safety & research recognition
          </p>
        </div>

        <div class="achievements-grid">
          <article class="achievement-card achievement-card-cyan">
            <span class="achievement-index">01</span>
            <p class="achievement-label">Mila · 2026</p>
            <h3>First Place — Rough-Terrain Quadruped Challenge</h3>
            <p>Won the Montréal Robotics Summer School challenge by training a quadruped locomotion policy to traverse difficult terrain in an intensive three-day build.</p>
          </article>

          <article class="achievement-card achievement-card-lime">
            <span class="achievement-index">02</span>
            <p class="achievement-label">CIFAR · 2026</p>
            <h3>Selected Participant — AI Frontiers School: AI Safety Edition</h3>
            <p>Selected for CIFAR's interdisciplinary AI safety program for early-stage PhD and advanced master's researchers.</p>
          </article>

          <article class="achievement-card achievement-card-purple">
            <span class="achievement-index">03</span>
            <p class="achievement-label">Mitacs · 2022</p>
            <h3>Globalink Research Internship</h3>
            <p>Completed a funded international research internship at INRS, investigating semantic segmentation for geospatial and Arctic imagery.</p>
          </article>

          <article class="achievement-card achievement-card-coral">
            <span class="achievement-index">04</span>
            <p class="achievement-label">Mitacs · 2023</p>
            <h3>Globalink Graduate Fellowship</h3>
            <p>Awarded a graduate fellowship to continue research in Canada following the Globalink Research Internship.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Featured Blogs Grid -->
    <section class="section-brutal">
      <div class="container-brutal">
        <div class="section-header-with-link">
          <div>
            <h2 class="section-title">
              <span class="title-bracket-purple">[</span>
              FEATURED WRITING
              <span class="title-bracket-purple">]</span>
            </h2>
            <p class="font-mono text-off-white/60">
              Essays, articles & research talks
            </p>
          </div>
          <a href="/blogs" class="view-all-link">
            View All →
          </a>
        </div>

        <!-- 3-Column Grid -->
        <div class="blogs-grid">
          {blogsWithGrids.map((blog, index) => (
            <a 
              href={blog.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="blog-card"
            >
              <!-- Card Number -->
              <div class="card-number">
                #{String(index + 1).padStart(2, '0')}
              </div>

              <!-- Content -->
              <div class="card-content">
                <h3 class="card-title">{blog.title}</h3>
                
                <div class="card-meta">
                  <span class="platform-badge">{blog.platform}</span>
                  <span class="date-text">
                    {new Date(blog.date).toLocaleDateString('en-US', { 
                      year: 'numeric', 
                      month: 'short' 
                    })}
                  </span>
                </div>

                <p class="card-excerpt">{blog.excerpt}</p>

                <!-- Category Badge -->
                {blog.category && (
                  <div class="category-badge">
                    {blog.category}
                  </div>
                )}
              </div>

              <!-- Probability Grid Section -->
              <div class="grid-section">
                <pre 
                  class="probability-grid" 
                  style={`color: ${blog.grid.color}`}
                >{blog.grid.ascii}</pre>
                <p class="pattern-name">{blog.grid.name}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Video Content -->
    <section id="videos" class="section-brutal">
      <div class="container-brutal">
        <YouTubeVideos />
      </div>
    </section>

    <!-- The Input: Currently Reading (Goodreads) -->
    <section id="input" class="section-brutal">
      <div class="container-brutal">
        <GoodreadsBooks />
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer-brutal">
      <div class="container-brutal">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
          <p class="font-mono text-sm text-off-white/60">
            Built with Astro 5.0 + Tailwind CSS v4
          </p>
          <div class="flex gap-4 font-mono text-sm">
            <a href="https://github.com/aryankargwal" target="_blank" class="hover:text-cyber-cyan">
              GitHub
            </a>
            <a href="https://linkedin.com/in/aryankargwal" target="_blank" class="hover:text-cyber-cyan">
              LinkedIn
            </a>
            <a href="https://twitter.com/aryankargwal" target="_blank" class="hover:text-cyber-cyan">
              Twitter
            </a>
          </div>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    @apply min-h-screen flex items-center justify-center;
    @apply pt-20 pb-32;
  }
  
  .hero-content {
    @apply flex flex-col md:flex-row items-stretch gap-12;
    @apply w-full;
  }

  /* Left column: text content */
  .hero-text-column {
    @apply flex-1 flex flex-col gap-8;
    @apply justify-start;
  }

  /* Right column: image */
  .hero-image-column {
    @apply flex-1 flex items-center justify-center;
    @apply md:pl-6;
  }
  
   /* Name plate with glitch effect */
   .name-plate {
     @apply relative;
   }
   
   /* Profile Picture */
   .profile-picture-link {
     @apply inline-block;
     text-decoration: none;
   }

   .profile-picture {
     @apply relative;
     @apply w-80 h-80;
   }

    .pfp-img {
      @apply w-80 h-80;
      @apply border-brutal border-black;
      @apply shadow-hard;
      @apply object-cover;
      filter: grayscale(100%) contrast(1.2);
    }

    .profile-picture-link:hover .pfp-img {
      @apply -translate-y-1;
    }

    .pfp-overlay {
      display: none;
    }

    .pfp-text {
      display: none;
    }
   
   .glitch-text {
     @apply text-8xl font-black;
     @apply text-off-white;
     position: relative;
     text-shadow: 
       2px 2px 0 #00f3ff,
       -2px -2px 0 #ff0055;
   }
  
  /* Tagline box */
  .tagline-box {
    @apply border-brutal border-black bg-dark-grey;
    @apply px-8 py-6 shadow-hard;
    @apply text-left;
  }
  
  /* Quick links */
  .quick-links {
    @apply flex flex-wrap gap-4;
    @apply md:justify-start justify-center;
  }
  
  /* Container */
  .container-brutal {
    @apply max-w-7xl mx-auto px-6 md:px-12;
  }
  
  /* Section */
  .section-brutal {
    @apply py-20;
  }
  
  /* Section header */
  .section-header {
    @apply mb-12 text-center;
  }
  
  .section-title {
    @apply text-3xl font-black mb-4;
    @apply text-off-white;
  }

  /* Achievements */
  .achievements-section {
    @apply pt-4;
  }

  .achievements-header {
    @apply mb-10;
  }

  .achievements-grid {
    @apply grid grid-cols-1 md:grid-cols-2 gap-6;
  }

  .achievement-card {
    @apply relative overflow-hidden;
    @apply bg-dark-grey border-brutal border-black shadow-hard;
    @apply p-7 min-h-64;
    @apply transition-all duration-300;
  }

  .achievement-card:hover {
    @apply -translate-y-1;
  }

  .achievement-index {
    @apply absolute top-4 right-5;
    @apply font-mono text-5xl font-black text-off-white/10;
  }

  .achievement-label {
    @apply relative z-10 inline-block mb-5 px-3 py-1;
    @apply font-mono text-xs font-bold uppercase tracking-wider text-black;
    @apply border border-black;
  }

  .achievement-card h3 {
    @apply relative z-10 max-w-lg mb-4;
    @apply text-2xl font-black leading-tight text-off-white;
  }

  .achievement-card p:last-child {
    @apply relative z-10 max-w-xl;
    @apply text-sm leading-relaxed text-off-white/75;
  }

  .achievement-card-cyan .achievement-label {
    @apply bg-cyber-cyan;
  }

  .achievement-card-lime .achievement-label {
    @apply bg-acid-lime;
  }

  .achievement-card-purple .achievement-label {
    @apply bg-purple-500 text-off-white;
  }

  .achievement-card-coral .achievement-label {
    @apply bg-[#ff6b6b];
  }
  
  .title-bracket {
    @apply text-cyber-cyan;
  }

  .title-bracket-purple {
    @apply text-purple-500;
  }
  
  /* Section header with link */
  .section-header-with-link {
    @apply mb-12 flex justify-between items-end;
    @apply flex-wrap gap-4;
  }

  .view-all-link {
    @apply text-sm font-mono font-bold;
    @apply text-off-white hover:text-acid-lime;
    @apply transition-colors duration-300;
    @apply no-underline;
  }

  /* Blogs Grid */
  .blogs-grid {
    @apply grid gap-6;
    @apply grid-cols-1 md:grid-cols-2 lg:grid-cols-3;
  }

  /* Blog Card */
  .blog-card {
    @apply relative;
    @apply bg-dark-grey border-brutal border-black;
    @apply shadow-hard hover:shadow-hard-cyan;
    @apply transition-all duration-300;
    @apply flex flex-col;
    @apply overflow-hidden;
    @apply no-underline;
    text-decoration: none;
  }

  .blog-card:hover {
    @apply -translate-y-1;
  }

  .card-number {
    @apply absolute top-3 right-3;
    @apply font-mono text-xs font-bold;
    @apply text-cyber-cyan;
    @apply bg-black/50 px-2 py-1;
    z-index: 2;
  }

  .card-content {
    @apply p-6 flex-1;
    @apply flex flex-col gap-3;
  }

  .card-title {
    @apply text-xl font-black text-off-white;
    @apply line-clamp-2;
    @apply pr-12;
  }

  .card-meta {
    @apply flex items-center gap-3 flex-wrap;
    @apply font-mono text-xs;
  }

  .platform-badge {
    @apply px-2 py-1;
    @apply bg-cyber-cyan text-black font-bold;
    @apply border border-black;
  }

  .date-text {
    @apply text-off-white/60;
  }

  .card-excerpt {
    @apply text-sm text-off-white/80;
    @apply line-clamp-3;
    @apply flex-1;
  }

  .category-badge {
    @apply inline-block self-start;
    @apply px-3 py-1;
    @apply bg-acid-lime text-black;
    @apply font-mono text-xs font-bold;
    @apply border border-black;
  }

  .grid-section {
    @apply bg-black/20;
    @apply p-4;
    @apply border-t-brutal border-black;
  }

  .probability-grid {
    @apply font-mono text-[10px] leading-[1.1];
    @apply mb-2;
    @apply whitespace-pre;
    @apply overflow-hidden;
  }

  .pattern-name {
    @apply font-mono text-[8px];
    @apply text-off-white/10;
    @apply uppercase tracking-wider;
    @apply transition-opacity duration-300;
  }

  .blog-card:hover .pattern-name {
    @apply text-off-white/30;
  }
  
  /* Bento Grid */
  .bento-grid {
    @apply grid gap-6;
    @apply grid-cols-1 md:grid-cols-2 lg:grid-cols-3;
  }
  
  /* Make first item span 2 columns on larger screens */
  .bento-grid > :first-child {
    @apply md:col-span-2;
  }
  
  /* Footer */
  .footer-brutal {
    @apply border-t-brutal border-black bg-dark-grey;
    @apply py-8 mt-20;
  }
</style>
