---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "PhD Researcher in AI & Robotics @ Polytechnique Montréal" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/jpeg" href="/img/fav.jpeg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <title>{title}</title>
  </head>
  <body class="bg-graphite text-off-white font-sans antialiased">
    <!-- Grain texture overlay -->
    <div class="grain-overlay"></div>
    
    <!-- Main content -->
    <slot />
    
    <style is:global>
      /* Global reset and base styles */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      html {
        scroll-behavior: smooth;
      }
      
      /* Grain texture overlay */
      .grain-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 9999;
        opacity: 0.05;
        background-image: url('/grain.svg');
        background-repeat: repeat;
        animation: grain 8s steps(10) infinite;
      }
      
      @keyframes grain {
        0%, 100% { transform: translate(0, 0); }
        10% { transform: translate(-5%, -10%); }
        20% { transform: translate(-15%, 5%); }
        30% { transform: translate(7%, -25%); }
        40% { transform: translate(-5%, 25%); }
        50% { transform: translate(-15%, 10%); }
        60% { transform: translate(15%, 0%); }
        70% { transform: translate(0%, 15%); }
        80% { transform: translate(3%, 35%); }
        90% { transform: translate(-10%, 10%); }
      }
      
      /* Neo-brutalist button base */
      .btn-brutal {
        @apply font-mono font-medium uppercase tracking-wide;
        @apply border-brutal border-black bg-off-white text-black;
        @apply px-6 py-3 shadow-hard;
        @apply transition-all duration-100;
        @apply cursor-pointer select-none;
      }
      
      .btn-brutal:hover {
        @apply bg-cyber-cyan shadow-hard-cyan;
      }
      
      .btn-brutal:active {
        @apply shadow-hard-collapsed translate-x-1 translate-y-1;
      }
      
      /* Hard-edged links */
      a {
        @apply text-off-white no-underline;
        @apply transition-colors duration-150;
      }
      
      a:hover {
        @apply text-cyber-cyan;
      }
      
      /* Scrollbar styling */
      ::-webkit-scrollbar {
        width: 12px;
      }
      
      ::-webkit-scrollbar-track {
        background: #1a1a1a;
        border-left: 2px solid #000;
      }
      
      ::-webkit-scrollbar-thumb {
        background: #00f3ff;
        border: 2px solid #000;
      }
      
      ::-webkit-scrollbar-thumb:hover {
        background: #ff0055;
      }
      
      /* Selection color */
      ::selection {
        background: #00f3ff;
        color: #000;
      }
      
      /* Code blocks */
      pre {
        @apply border-brutal border-black p-4 overflow-x-auto;
        @apply bg-dark-grey shadow-hard;
      }
      
      code {
        @apply font-mono text-sm;
      }
      
      /* Headings */
      h1, h2, h3, h4, h5, h6 {
        @apply font-sans font-bold;
        @apply tracking-tight;
      }
      
      h1 {
        @apply text-5xl md:text-7xl;
      }
      
      h2 {
        @apply text-4xl md:text-5xl;
      }
      
      h3 {
        @apply text-3xl md:text-4xl;
      }
    </style>
  </body>
</html>
