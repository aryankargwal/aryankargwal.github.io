# GitHub Personal Access Token
# Get one at: https://github.com/settings/tokens
# Only needs 'read:user' scope for contribution graph
GITHUB_TOKEN=your_github_token_here

# Goodreads User ID (Optional - already set in component)
# Find it in your Goodreads profile URL
# Example: https://www.goodreads.com/user/show/185223761-aryan-kargwal
# Your ID is: 185223761
GOODREADS_USER_ID=185223761
